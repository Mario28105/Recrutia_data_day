{
  "providers": ["php"],
  "phases": {
    "setup": {
      "nixPkgs": ["php82", "php82Extensions.pdo_pgsql", "composer"]
    },
    "install": {
      "cmds": ["composer install --no-dev --no-interaction --prefer-dist --no-scripts"]
    }
  },
  "start": {
    "cmd": "php artisan migrate --force && php artisan serve --host=0.0.0.0 --port=$PORT"
  }
}